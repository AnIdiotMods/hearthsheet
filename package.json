{
  "name": "hearthsheet",
  "version": "0.4.0",
  "description": "Open-source 5e character manager, file-compatible with the community compendium XML format",
  "license": "MIT",
  "author": "Hearthsheet contributors",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "node scripts/signing-config.mjs && tauri build --config src-tauri/tauri.signing.json",
    "app:build:windows-from-linux": "node scripts/signing-config.mjs && tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis --config src-tauri/tauri.signing.json",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk --aab",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/opendyslexic": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
