{
  "name": "hearthsheet",
  "version": "0.1.0",
  "description": "Open-source 5e character manager, file-compatible with the community compendium XML format",
  "license": "MIT",
  "author": "Hearthsheet contributors",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "electron": "electron .",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "org.hearthsheet.app",
    "productName": "Hearthsheet",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/opendyslexic": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
